# Copy thành .env và điền giá trị thật. KHÔNG commit .env.

# Production Vercel + Turso — Turso Marketplace tự tạo 2 biến này
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Prisma CLI chỉ dùng SQLite local để tạo migration
LOCAL_DATABASE_URL="file:./seryn-dev.db"

# Runtime local — để ngoài thư mục OneDrive/Drive sync
DATABASE_URL="file:C:/SerynOps/data/seryn.db"

# Đồng bộ 2 chiều Google Calendar — xem docs/GOOGLE-CALENDAR-SETUP.md để lấy giá trị
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:4000/api/google/callback"

# Khóa truy cập app — production phải bật ít nhất Google whitelist hoặc password
AUTH_ALLOWED_EMAILS=
GOOGLE_LOGIN_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"
APP_PASSWORD=

# Các key dưới đây dùng ở giai đoạn sau (I, J, L) — chưa cần ở Giai đoạn A
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ANTHROPIC_API_KEY=
